(define two (+ 1 1))


two
;;|| --- Result --- ||
;;|| Res: 2


:e
(define bad (0))
;;|| --- Result --- ||
;;|| [Runtime Error]: 0 is not a function.
;;||  17 | (define bad (0))
;;||                   ^^^ 


(define (id x) x)


(id 42)
;;|| --- Result --- ||
;;|| Res: 42


(id id)
;;|| --- Result --- ||
;;|| Res: [Function]


(define (square x) (* x x))


(square 21)
;;|| --- Result --- ||
;;|| Res: 441


(define (sum-of-squares x y)
  (+ (square x) (square y)))


(sum-of-squares 3 4)
;;|| --- Result --- ||
;;|| Res: 25


(define (bad-square x) (* x y))


:e
(bad-square 42)
;;|| --- Result --- ||
;;|| [Runtime Error]: name not found: y
;;||  58 | (bad-square 42)
;;||       ^^^^^^^^^^^^^^^


(define (bad-sum-of-squares x y)
  (+ (bad-square x) (bad-square y)))


:e no unexpected capturing
(bad-sum-of-squares 3 4)
;;|| --- Result --- ||
;;|| [Runtime Error]: name not found: y
