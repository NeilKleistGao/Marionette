(define (prec x)
  (if (= x 0) 0 (- x 1)))


(prec 0)
;;|| --- Result --- ||
;;|| Res: 0


(prec 43)
;;|| --- Result --- ||
;;|| Res: 42


(define (abs x)
  (cond
    ((> x 0) x)
    ((< x 0) (neg x))
    ((= x 0) 0)))


(abs 0)
;;|| --- Result --- ||
;;|| Res: 0


(abs 1)
;;|| --- Result --- ||
;;|| Res: 1


(abs -2)
;;|| --- Result --- ||
;;|| Res: 2


