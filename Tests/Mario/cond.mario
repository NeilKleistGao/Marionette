;;||             ^^^^^ 


(define (abs2 x)
  (cond
    ((< x 0) (neg x))
    (else x)))


(abs2 0)
;;|| --- Result --- ||
;;|| Res: 0


(abs2 1)
;;|| --- Result --- ||
;;|| Res: 1


(abs2 -2)
;;|| --- Result --- ||
;;|| Res: 2



