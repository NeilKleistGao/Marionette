(define (expt b n)
  (if (= n 0) 1 (* b (expt b (- n 1)))))


(expt 3 3)
;;|| --- Result --- ||
;;|| Res: 27


(expt 2 10)
;;|| --- Result --- ||
;;|| Res: 1024


(define (expt' b n)
  (define (iter r i)
    (if (= i 0) r (iter (* b r) (- i 1))))
  (iter 1 n))


(expt' 3 3)
;;|| --- Result --- ||
;;|| Res: 27


(expt' 2 10)
;;|| --- Result --- ||
;;|| Res: 1024


(define (even? n)
  (= (% n 2) 0))


(even? 1)
;;|| --- Result --- ||
;;|| Res: False

(even? 42)
;;|| --- Result --- ||
;;|| Res: True


(define (square n) (* n n))

(define (fast-expt b n)
  (cond ((= n 0) 1)
        ((even? n) (square (fast-expt b (/ n 2))))
        (else (* b (fast-expt b (- n 1))))))

(fast-expt 3 3)
;;|| --- Result --- ||
;;|| Res: 27


(fast-expt 2 10)
;;|| --- Result --- ||
;;|| Res: 1024


(define (double x) (* 2 x))
(define (halve x) (/ x 2))


(define (my-mult x y)
  (cond ((= y 0) 0)
        ((even? y) (double (my-mult x (halve y))))
        (else (+ x (my-mult x (- y 1))))))


(my-mult 3 4)
;;|| --- Result --- ||
;;|| Res: 12
